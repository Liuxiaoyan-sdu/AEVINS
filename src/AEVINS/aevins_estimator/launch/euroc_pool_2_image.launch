<launch>
    <arg name="output_type" default="screen"/>
    <arg name="config_path" default = "$(find feature_tracker)/../config/euroc/pool_image.yaml" />
	  <arg name="aevins_path" default = "$(find feature_tracker)/../config/../" />
    <arg name="input_file"  default=""/>

    <!-- ── 图像压暗节点（降低曝光）────────────────────────────────────── -->
    <!-- enable_darkener: 1=开启压暗并使用暗化图像, 0=跳过节点 -->
    <arg name="enable_darkener"  default="1"/>
    <!-- method: gamma（推荐）或 scale -->
    <arg name="darkener_method"  default="gamma"/>
    <!-- gamma>1 时图像变暗，典型值 1.5~3.0；2.0 为默认 -->
    <arg name="darkener_gamma"   default="1.0"/>
    <!-- scale 线性缩放，0.0~1.0，值越小越暗；仅 method=scale 时生效 -->
    <arg name="darkener_scale"   default="0.3"/>
    <!-- 压暗节点的输入话题（压缩图） -->
    <arg name="darkener_input"   default="/dvs/image_raw/compressed"/>
    <!-- 压暗节点的输出话题（raw，下游节点直接订阅此话题） -->
    <arg name="darkener_output"  default="/dvs/image_raw"/>
    <!-- 解压缩但不做任何变换的输出话题 -->
    <arg name="raw_output"       default="/dvs/image_raw_unmodified"/>

    <node if="$(arg enable_darkener)"
          name="image_darkener" pkg="tools" type="image_darkener_node.py"
          output="screen" respawn="false">
        <param name="~input_topic"   value="$(arg darkener_input)"/>
        <param name="~output_topic"  value="$(arg darkener_output)"/>
        <param name="~method"        value="$(arg darkener_method)"/>
        <param name="~gamma"         value="$(arg darkener_gamma)"/>
        <param name="~scale"         value="$(arg darkener_scale)"/>
        <param name="~queue_size"    value="1"/>
    </node>

    <!-- 同时将压缩图解压后原样发布，不做任何亮度变换 -->
    <node name="dvs_image_republish" pkg="image_transport" type="republish"
          args="compressed in:=/dvs/image_raw raw out:=$(arg raw_output)"
          output="log" />
    <!-- ──────────────────────────────────────────────────────────────── -->

    <node name="imu2dvl" pkg="tools" type="imu2dvl.py" output="screen">
       <param name="config_file" type="string" value="$(arg config_path)" />
       <param name="aevins_folder" type="string" value="$(arg aevins_path)" />
    </node>

    <node pkg="feature_tracker_image" name="feature_tracker" type="feature_tracker_image" output="log" respawn="false">
    <param name="~process_data" type="bool" value="true"/>
    <param name="~config_file" type="string" value="$(arg config_path)"/>
    <param name="~aevins_folder" type="string" value="$(arg aevins_path)"/>
    <param name="~input_file" type="string" value="$(arg input_file)"/>
    </node>

    <node name="aevins_estimator" pkg="aevins_estimator" type="aevins_estimator" output="screen">
       <param name="config_file" type="string" value="$(arg config_path)" />
       <param name="aevins_folder" type="string" value="$(arg aevins_path)" />
    </node>

    <node name="pose_graph" pkg="pose_graph" type="pose_graph" output="screen">
        <param name="config_file" type="string" value="$(arg config_path)" />
        <param name="visualization_shift_x" type="int" value="0" />
        <param name="visualization_shift_y" type="int" value="0" />
        <param name="skip_cnt" type="int" value="0" />
        <param name="skip_dis" type="double" value="0" />
    </node>


    <node name="rvizvisualisation" pkg="rviz" type="rviz" output="log" args="-d $(find aevins_estimator)/../config/aevins_rviz_config.rviz" />

</launch>

<!-- rosbag play -s195 best.bag -->
<!-- rosbag play -s20 9-PoolCS#09.bag -->