<launch>
    <arg name="config_path" default = "$(find feature_tracker)/../config/euroc/euroc_config_out.yaml" />
	  <arg name="aevins_path" default = "$(find feature_tracker)/../config/../" />
    
    <node name="feature_tracker" pkg="feature_tracker" type="feature_tracker" output="screen">
        <param name="config_file" type="string" value="$(arg config_path)" />
        <param name="aevins_folder" type="string" value="$(arg aevins_path)" />
    </node>

    <node name="aevins_estimator" pkg="aevins_estimator" type="aevins_estimator" output="screen">
       <param name="config_file" type="string" value="$(arg config_path)" />
       <param name="aevins_folder" type="string" value="$(arg aevins_path)" />
    </node>

    <node name="pose_graph" pkg="pose_graph" type="pose_graph" output="screen">
        <param name="config_file" type="string" value="$(arg config_path)" />
        <param name="visualization_shift_x" type="int" value="0" />
        <param name="visualization_shift_y" type="int" value="0" />
        <param name="skip_cnt" type="int" value="0" />
        <param name="skip_dis" type="double" value="0" />
    </node>

    <node name="rvizvisualisation" pkg="rviz" type="rviz" output="log" args="-d $(find aevins_estimator)/../config/aevins_rviz_config.rviz" />

    <node name="gloab" pkg="get_image" type="wight_balance_image.py" output="log" />

    <node name="rosbag_play" pkg="rosbag" type="play" args="--start=0 --duration=150 /media/lxy/39FF5B6EB5491C1F/data17/pool/sort_17.bag" />

</launch>