<launch>
  <arg name="output_type" default="screen"/>
  <arg name="config_path" default="$(find feature_tracker_event)/euroc/euroc_config_25.yaml"/>
  <arg name="input_file"  default=""/>
  <arg name="aevins_path" default="$(find feature_tracker_event)/../"/>

  <node pkg="feature_tracker_event" name="feature_tracker_event" type="bf_visualizer_nd" output="$(arg output_type)" respawn="false">
    <param name="~process_data" type="bool" value="true"/>
    <param name="~config_file" type="string" value="$(arg config_path)"/>
    <param name="~aevins_folder" type="string" value="$(arg aevins_path)"/>
    <param name="~input_file" type="string" value="$(arg input_file)"/>
  </node>

  <!-- Start rviz visualization with preset config -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find feature_tracker_event)/launch/better_visualizer.rviz"/>
</launch>
 
