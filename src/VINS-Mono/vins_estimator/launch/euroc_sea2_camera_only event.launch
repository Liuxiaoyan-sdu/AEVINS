<launch>
    <arg name="output_type" default="screen"/>
    <arg name="config_path" default = "$(find feature_tracker)/../config/euroc/sea2_camera_only event.yaml" />
	<arg name="vins_path" default = "$(find feature_tracker)/../config/../" />
    <arg name="input_file"  default=""/>
    <arg name="loop_match_image_path" default=""/>
    <arg name="enable_rviz" default="true"/>

    <node name="imu2dvl_cave" pkg="tools" type="imu2dvl_river.py" output="screen">
       <param name="config_file" type="string" value="$(arg config_path)" />
       <param name="vins_folder" type="string" value="$(arg vins_path)" />
    </node>

    <node pkg="feature_tracker_image" name="feature_tracker" type="feature_tracker_image" output="log" respawn="false">
    <param name="~process_data" type="bool" value="false"/>
    <param name="~config_file" type="string" value="$(arg config_path)"/>
    <param name="~vins_folder" type="string" value="$(arg vins_path)"/>
    <param name="~input_file" type="string" value="$(arg input_file)"/>
    </node>

    <node name="vins_estimator" pkg="vins_estimator" type="vins_estimator" output="screen">
       <param name="config_file" type="string" value="$(arg config_path)" />
       <param name="vins_folder" type="string" value="$(arg vins_path)" />
    </node>

    <node name="pose_graph" pkg="pose_graph" type="pose_graph" output="screen">
        <param name="config_file" type="string" value="$(arg config_path)" />
        <param name="visualization_shift_x" type="int" value="0" />
        <param name="visualization_shift_y" type="int" value="0" />
        <param name="skip_cnt" type="int" value="0" />
        <param name="skip_dis" type="double" value="0" />
        <param name="loop_match_image_path" type="string" value="$(arg loop_match_image_path)" />
        <param name="input_file" type="string" value="$(arg input_file)" />
    </node>

    <node name="dvs_image_republish" pkg="image_transport" type="republish" 
          args="compressed in:=/dvs/image_raw raw out:=/dvs/image_raw" 
          output="log" />

    <!-- The bag stores /dvs/image_raw/compressed; publish decoded mono frames on /dvs/image_raw. -->

    <node if="$(arg enable_rviz)" name="rvizvisualisation" pkg="rviz" type="rviz" output="log" args="-d $(find vins_estimator)/../config/vins_rviz_config.rviz" />

</launch>
